{
  "name": "immich",
  "services": {
    "database": {
      "image": "ghcr.io/immich-app/postgres@sha256:bcf63357191b76a916ae5eb93464d65c07511da41e3bf7a8416db519b40b1c23",
      "env_file": [
        "database.env"
      ],
      "volumes": [
        "./postgres:/var/lib/postgresql/data"
      ],
      "shm_size": "128mb",
      "mem_limit": "1200m",
      "restart": "unless-stopped"
    },
    "redis": {
      "image": "valkey/valkey@sha256:418652cfb58ef879d4978c33553735d7147016032d5aefaa14c828e611eb9dfd",
      "mem_limit": "128m",
      "restart": "unless-stopped",
      "volumes": [
        "./redis:/data"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "valkey-cli",
          "ping"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 10
      }
    },
    "immich-server": {
      "image": "ghcr.io/immich-app/immich-server@sha256:d317916b28090c33eb36b308464ea391f8b7df1d850fcfea227a39ec879718c2",
      "env_file": [
        "server.env"
      ],
      "volumes": [
        "/mnt/Global_Share/Adam/Photos:/usr/src/app/upload"
      ],
      "ports": [
        "2283:2283"
      ],
      "depends_on": [
        "database",
        "redis",
        "immich-machine-learning"
      ],
      "mem_limit": "1600m",
      "restart": "unless-stopped",
      "healthcheck": {
        "start_period": "10m"
      }
    },
    "immich-machine-learning": {
      "image": "ghcr.io/immich-app/immich-machine-learning@sha256:e16c2f166a8174901959fdf85e2e4c7bd1ebc4b37e0b6655de97c41408a260c4",
      "volumes": [
        "./model-cache:/cache"
      ],
      "mem_limit": "1200m",
      "restart": "unless-stopped",
      "environment": {
        "MACHINE_LEARNING_REQUEST_THREADS": "1",
        "MACHINE_LEARNING_MODEL_INTER_OP_THREADS": "1",
        "MACHINE_LEARNING_MODEL_INTRA_OP_THREADS": "2"
      }
    }
  }
}
