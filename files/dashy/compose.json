{
  "services": {
    "dashy": {
      "image": "lissy93/dashy@sha256:3fd136041ecc04e53342b17efe987091a72c6a6c2ffc8b468c30f0361990066c",
      "container_name": "Dashy",
      "restart": "unless-stopped",
      "ports": [
        "4001:8080"
      ],
      "volumes": [
        "./user-data:/app/user-data"
      ],
      "env_file": [
        "./source.env"
      ],
      "mem_limit": "512m",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    }
  }
}
