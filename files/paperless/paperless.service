[Unit]
Description=Usniverse Paperless (requires real NAS media)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/paperless
ExecStartPre=/usr/bin/test -f /mnt/paperless-media/.usniverse-paperless-nas
ExecStart=/usr/bin/docker compose up -d --wait --wait-timeout 600
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=660
[Install]
WantedBy=multi-user.target
